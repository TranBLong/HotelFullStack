@page "/login"
@model HotelBlazor.Pages.Account.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - HotelBlazor</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/app.css" />
</head>
<body class="hotel-auth-body">
    <main class="hotel-auth-page">
        <section class="hotel-auth-layout">
            <div class="hotel-auth-image-panel">
                <img src="/images/hotel/hotel-login.jpg"
                     alt="Phòng nghỉ khách sạn sáng sủa với nội thất tinh tế"
                     fetchpriority="high" />
                <div class="hotel-auth-image-shade"></div>
                <div class="hotel-auth-image-caption">
                    <a class="hotel-auth-brand" href="/">HotelBlazor</a>
                    <p>Chạm vào nhịp nghỉ ngơi<br />dịu dàng của riêng bạn.</p>
                </div>
            </div>
            <div class="hotel-auth-form-panel">
                <div class="hotel-auth-form-content">
                    <a class="hotel-auth-mobile-brand" href="/">HotelBlazor</a>
                    <p class="hotel-eyebrow">Chào mừng trở lại</p>
                    <h1 class="h2 mb-2">Đăng nhập</h1>
                    <p class="text-secondary mb-4">Đăng nhập để tiếp tục quản lý kỳ nghỉ của bạn.</p>

                    @if (Model.AccessDenied)
                    {
                        <div class="alert alert-warning" role="alert">Tài khoản của bạn không có quyền truy cập trang đó.</div>
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <form method="post">
                        <input type="hidden" asp-for="Input.ReturnUrl" />
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Mật khẩu</label>
                            <input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="current-password" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        <div class="form-check mb-4">
                            <input asp-for="Input.RememberMe" class="form-check-input" />
                            <label asp-for="Input.RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100">Đăng nhập</button>
                    </form>
                    <p class="text-center text-secondary mt-4 mb-0">
                        Chưa có tài khoản? <a href="/register" class="link-primary">Đăng ký</a>
                    </p>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
