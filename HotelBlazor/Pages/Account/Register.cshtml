@page "/register"
@model HotelBlazor.Pages.Account.RegisterModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - HotelBlazor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/app.css" asp-append-version="true" />
</head>
<body class="hotel-auth-body">
    <main class="hotel-auth-page">
        <section class="hotel-auth-layout">
            <div class="hotel-auth-image-panel">
                <img src="/images/hotel/hotel-login.jpg"
                     alt="Phòng nghỉ khách sạn sáng sủa với nội thất tinh tế"
                     fetchpriority="high" />
                <div class="hotel-auth-image-shade"></div>
                <div class="hotel-auth-image-caption">
                    <a class="hotel-auth-brand" href="/">HotelBlazor</a>
                    <p>Một không gian mới<br />cho những hành trình mới.</p>
                </div>
            </div>
            <div class="hotel-auth-form-panel">
                <div class="hotel-auth-form-content">
                    <a class="hotel-auth-mobile-brand" href="/">HotelBlazor</a>
                    <p class="hotel-eyebrow">Bắt đầu hành trình</p>
                    <h1 class="h2 mb-2">Tạo tài khoản</h1>
                    <p class="text-secondary mb-4">Đăng ký để tìm và đặt phòng thuận tiện.</p>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Input.FullName" class="form-label">Họ và tên</label>
                            <input asp-for="Input.FullName" class="form-control form-control-lg" autocomplete="name" />
                            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="email" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Mật khẩu</label>
                            <input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="new-password" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword" class="form-label">Nhập lại mật khẩu</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100">Tạo tài khoản</button>
                    </form>
                    <p class="text-center text-secondary mt-4 mb-0">
                        Đã có tài khoản? <a href="/login" class="link-primary">Đăng nhập</a>
                    </p>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
