@page "/access-denied"
@{
    Layout = null;
    ViewData["Title"] = "Không có quyền truy cập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - HotelBlazor</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-body-tertiary">
    <main class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
        <section class="card border-0 shadow-sm text-center" style="max-width: 480px;">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3">Không có quyền truy cập</h1>
                <p class="text-secondary">Tài khoản của bạn không được phép mở trang này.</p>
                <a href="/" class="btn btn-primary">Về trang chủ</a>
            </div>
        </section>
    </main>
</body>
</html>
