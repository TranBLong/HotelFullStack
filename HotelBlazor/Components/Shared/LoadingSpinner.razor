<div class="loading-panel" role="status" aria-live="polite">
    <span class="spinner-border text-primary" aria-hidden="true"></span>
    <span>@Message</span>
    <span class="loading-skeleton" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
    </span>
</div>

@code {
    [Parameter]
    public string Message { get; set; } = "Đang tải...";
}
