<header class="hotel-navbar">
    <div class="container hotel-navbar-inner">
        <a class="hotel-brand" href="/" aria-label="HotelBlazor - Trang chủ">
            <span class="hotel-brand-mark" aria-hidden="true">H</span>
            <span>
                <strong>HotelBlazor</strong>
                <small>Không gian nghỉ dưỡng</small>
            </span>
        </a>

        <button class="hotel-menu-toggle"
                type="button"
                aria-expanded="@IsMenuOpen"
                aria-controls="hotel-primary-navigation"
                @onclick="ToggleMenu">
            <span class="hotel-menu-icon" aria-hidden="true"></span>
            <span>Menu</span>
        </button>

        <div id="hotel-primary-navigation" class="hotel-navigation @(IsMenuOpen ? "hotel-navigation-open" : string.Empty)">
            <nav class="hotel-nav-links" aria-label="Điều hướng chính">
                <NavLink class="hotel-nav-link" href="/" Match="NavLinkMatch.All" @onclick="CloseMenu">Trang chủ</NavLink>
                <AuthorizeView Roles="@Role.Customer">
                    <NavLink class="hotel-nav-link" href="/rooms" @onclick="CloseMenu">Tìm phòng</NavLink>
                    <NavLink class="hotel-nav-link" href="/my-bookings" @onclick="CloseMenu">Đơn của tôi</NavLink>
                </AuthorizeView>
                <AuthorizeView Roles="@Role.Receptionist">
                    <NavLink class="hotel-nav-link" href="/reception" @onclick="CloseMenu">Sơ đồ phòng</NavLink>
                    <NavLink class="hotel-nav-link" href="/reception/walk-in" @onclick="CloseMenu">Khách vãng lai</NavLink>
                    <NavLink class="hotel-nav-link" href="/reception/bookings" @onclick="CloseMenu">Hàng chờ đơn</NavLink>
                </AuthorizeView>
                <AuthorizeView Roles="@Role.Admin">
                    <NavLink class="hotel-nav-link" href="/dashboard" @onclick="CloseMenu">Tổng quan</NavLink>
                    <NavLink class="hotel-nav-link" href="/admin/bookings" @onclick="CloseMenu">Đơn đặt</NavLink>
                    <NavLink class="hotel-nav-link" href="/admin/rooms" @onclick="CloseMenu">Phòng</NavLink>
                    <NavLink class="hotel-nav-link" href="/admin/room-types" @onclick="CloseMenu">Loại phòng</NavLink>
                    <NavLink class="hotel-nav-link" href="/admin/users" @onclick="CloseMenu">Tài khoản</NavLink>
                    <NavLink class="hotel-nav-link" href="/admin/users/create" @onclick="CloseMenu">Tạo nhân viên</NavLink>
                </AuthorizeView>
            </nav>

            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="hotel-account">
                        <span class="hotel-account-name">@auth.User.Identity?.Name</span>
                        <form method="post" action="/logout">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-outline-primary btn-sm">Đăng xuất</button>
                        </form>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="hotel-account">
                        <a class="btn btn-outline-primary btn-sm" href="/login">Đăng nhập</a>
                        <a class="btn btn-primary btn-sm" href="/register">Đăng ký</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@code {
    private bool IsMenuOpen { get; set; }

    private void ToggleMenu() => IsMenuOpen = !IsMenuOpen;
    private void CloseMenu() => IsMenuOpen = false;
}
