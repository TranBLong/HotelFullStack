@page "/my-bookings"
@attribute [Authorize(Roles = Role.Customer)]
@inject BookingService BookingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<BookingHistory> Logger

<PageTitle>Đơn của tôi - HotelBlazor</PageTitle>

<div class="mb-4">
    <p class="text-primary fw-semibold text-uppercase small mb-2">Lịch sử lưu trú</p>
    <h1 class="display-6 fw-semibold mb-2">Đơn đặt phòng của tôi</h1>
    <p class="text-secondary mb-0">Theo dõi trạng thái các yêu cầu đặt phòng của bạn.</p>
</div>

@if (IsLoading)
{
    <LoadingSpinner Message="Đang tải đơn đặt phòng..." />
}
else if (ErrorMessage is not null)
{
    <ErrorAlert Message="@ErrorMessage" OnRetry="LoadAsync" />
}
else if (Bookings is null || Bookings.Count == 0)
{
    <div class="text-center rounded-4 border bg-white py-5 px-3">
        <h2 class="h4">Bạn chưa có đơn đặt phòng</h2>
        <p class="text-secondary">Tìm phòng phù hợp để bắt đầu lên kế hoạch cho kỳ nghỉ.</p>
        <a class="btn btn-primary" href="/rooms">Tìm phòng</a>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var booking in Bookings)
        {
            <article class="card border-0 shadow-sm" @key="booking.Id">
                <div class="card-body p-3 p-md-4">
                    <div class="row g-3 align-items-center">
                        <div class="col-12 col-md">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <h2 class="h5 mb-0">Đơn #@booking.Id · Phòng @booking.Room.RoomNumber</h2>
                                <span class="badge rounded-pill @GetStatusClass(booking.Status)">@GetStatusLabel(booking.Status)</span>
                            </div>
                            <p class="text-secondary mb-2">@booking.Room.RoomType.Name · @booking.CheckIn.ToString("dd/MM/yyyy") – @booking.CheckOut.ToString("dd/MM/yyyy")</p>
                            <strong>@FormatPrice(booking.TotalAmount)</strong>
                            @if (!string.IsNullOrWhiteSpace(booking.RejectionReason))
                            {
                                <p class="text-danger small mb-0 mt-2">Lý do: @booking.RejectionReason</p>
                            }
                        </div>
                        @if (booking.Status == BookingStatus.Pending)
                        {
                            <div class="col-12 col-md-auto">
                                <button type="button"
                                        class="btn btn-outline-danger w-100"
                                        disabled="@IsCancelling"
                                        @onclick="() => CancelAsync(booking.Id)">
                                    @(IsCancelling ? "Đang hủy..." : "Hủy đơn")
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
}

@code {
    private IReadOnlyList<Booking>? Bookings { get; set; }
    private bool IsLoading { get; set; }
    private bool IsCancelling { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        Bookings = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrWhiteSpace(userId))
            {
                throw new InvalidOperationException("Không xác định được tài khoản hiện tại.");
            }

            Bookings = await BookingService.GetForUserAsync(userId);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Không thể tải đơn đặt phòng của khách hàng.");
            ErrorMessage = "Không thể tải danh sách đơn. Vui lòng thử lại.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task CancelAsync(int bookingId)
    {
        ErrorMessage = null;
        IsCancelling = true;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrWhiteSpace(userId))
            {
                throw new InvalidOperationException("Không xác định được tài khoản hiện tại.");
            }

            await BookingService.CancelPendingAsync(bookingId, userId);
            await LoadAsync();
        }
        catch (BookingRequestException exception)
        {
            ErrorMessage = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Không thể hủy đơn {BookingId}.", bookingId);
            ErrorMessage = "Không thể hủy đơn đặt phòng. Vui lòng thử lại.";
        }
        finally
        {
            IsCancelling = false;
        }
    }

    private static string GetStatusClass(BookingStatus status) => status switch
    {
        BookingStatus.Pending => "text-bg-warning",
        BookingStatus.Confirmed => "text-bg-primary",
        BookingStatus.CheckedIn => "text-bg-success",
        BookingStatus.Completed => "text-bg-secondary",
        BookingStatus.Cancelled => "text-bg-danger",
        _ => "text-bg-secondary"
    };

    private static string GetStatusLabel(BookingStatus status) => status switch
    {
        BookingStatus.Pending => "Chờ xác nhận",
        BookingStatus.Confirmed => "Đã xác nhận",
        BookingStatus.CheckedIn => "Đang lưu trú",
        BookingStatus.Completed => "Đã hoàn tất",
        BookingStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };

    private static string FormatPrice(decimal amount) =>
        $"{amount.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))} ₫";
}
