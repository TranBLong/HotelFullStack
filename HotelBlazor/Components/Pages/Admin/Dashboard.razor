@page "/dashboard"
@attribute [Authorize(Roles = Role.Admin)]

<PageTitle>Tổng quan quản trị - HotelBlazor</PageTitle>
<section class="admin-dashboard">
    <div class="mb-4">
        <p class="text-uppercase text-primary fw-semibold small mb-1">Khu vực quản trị</p>
        <h1 class="h2 fw-bold mb-1">Tổng quan khách sạn</h1>
        <p class="text-secondary mb-0">Theo dõi nhanh tình hình phòng và đơn đặt.</p>
    </div>

    @if (_loading)
    {
        <LoadingSpinner Message="Đang tải số liệu tổng quan..." />
    }
    else if (_error is not null)
    {
        <ErrorAlert Message="@_error" OnRetry="LoadAsync" />
    }
    else if (_data is null)
    {
        <div class="alert alert-info">Chưa có số liệu để hiển thị.</div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card dashboard-stat-card dashboard-stat-card--navy h-100"><div class="card-body">
                    <p class="dashboard-stat-label">Tổng số phòng</p>
                    <p class="dashboard-stat-value">@_data.TotalRooms</p>
                </div></div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card dashboard-stat-card dashboard-stat-card--green h-100"><div class="card-body">
                    <p class="dashboard-stat-label">Phòng trống</p>
                    <p class="dashboard-stat-value">@_data.AvailableRooms</p>
                </div></div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card dashboard-stat-card dashboard-stat-card--gold h-100"><div class="card-body">
                    <p class="dashboard-stat-label">Đơn chờ duyệt</p>
                    <p class="dashboard-stat-value">@_data.PendingBookings</p>
                </div></div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card dashboard-stat-card dashboard-stat-card--teal h-100"><div class="card-body">
                    <p class="dashboard-stat-label">Doanh thu dự kiến</p>
                    <p class="dashboard-stat-value dashboard-stat-revenue">@_data.ExpectedRevenue.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫</p>
                </div></div>
            </div>
        </div>

        <section class="card border-0 shadow-sm mt-4">
            <div class="card-body d-flex flex-wrap gap-2">
                <a class="btn btn-primary" href="/admin/bookings">Xem toàn bộ đơn</a>
                <a class="btn btn-outline-primary" href="/admin/rooms">Quản lý phòng</a>
                <a class="btn btn-outline-primary" href="/admin/users">Quản lý tài khoản</a>
            </div>
        </section>
    }
</section>

@code {
    [Inject] private AdminService AdminService { get; set; } = null!;
    [Inject] private ILogger<Dashboard> Logger { get; set; } = null!;

    private AdminDashboardData? _data;
    private bool _loading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _data = await AdminService.GetDashboardAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Không thể tải số liệu dashboard quản trị.");
            _error = "Không thể tải số liệu lúc này. Vui lòng thử lại.";
        }
        finally
        {
            _loading = false;
        }
    }
}
